    {
      "id": "0jE4QvnfncU9F-UAS25tk",
      "type": "text",
      "x": 8975.120636803043,
      "y": 1642.9367450139187,
      "width": 340,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
